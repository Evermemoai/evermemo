# evermemo environment configuration (example)
#
# Nothing here is required — evermemo runs out of the box with a local SQLite
# database and keyword search. Uncomment only what you need.
# See CONTRIBUTING.md for how to load this file, and docs/ollama.md for Ollama.

# ── Core ──────────────────────────────────────────────────────────────────
# Database file path (default: ~/.evermemo/evermemo.db).
#EVERMEMO_DB=./evermemo.db

# ── HTTP API auth (for `evermemo serve`) ─────────────────────────────────
#EVERMEMO_API_KEY=dev-secret
#EVERMEMO_AGENT_KEYS=claude:key1,cursor:key2
#EVERMEMO_RATE=120
#EVERMEMO_ACL=claude:eng:rw,cursor:eng:r,auditor:*:r

# ── Provenance / hub mode ────────────────────────────────────────────────
#EVERMEMO_AGENT=dev
#EVERMEMO_REMOTE=http://localhost:7777

# ── Semantic search (embeddings) ─────────────────────────────────────────
#EVERMEMO_EMBED_URL=http://localhost:11434
#EVERMEMO_EMBED_MODEL=nomic-embed-text
#EVERMEMO_EMBED_PROVIDER=ollama
#EVERMEMO_EMBED_API_KEY=

# ── Consolidation LLM (for `evermemo consolidate`) ───────────────────────
#EVERMEMO_LLM_URL=http://localhost:11434
#EVERMEMO_LLM_MODEL=llama3.2
#EVERMEMO_LLM_PROVIDER=ollama
#EVERMEMO_LLM_API_KEY=
